{
  "name": "fluxoid",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun run --cwd server dev",
    "dev:client": "bun run --cwd client dev",
    "test": "bun run --cwd server test",
    "test:modular": "bun run --cwd server scripts/test-modular-live.ts",
    "build": "bun run --cwd client build",
    "doctor": "bun run --cwd client doctor"
  }
}
