MODULAR_API_KEY=
PORT=3000
DATA_DIR=./data
CORS_ORIGIN=http://localhost:5173

# Optional: enable site-wide login (standalone /login page, not in the React app).
# When both are set, all routes except /login require authentication.
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
# openssl rand -base64 32
# AUTH_SECRET=change-me-to-a-long-random-string

INPUT_MIN_WIDTH=768
INPUT_MIN_HEIGHT=768
INPUT_MAX_BYTES=1500000
INPUT_MAX_LONG_EDGE=2048
INPUT_QUALITY=85

MODULAR_API_URL=https://api.modular.com/v1/responses
MODULAR_STEPS=4
MODULAR_GUIDANCE_SCALE=7.5
MODULAR_SEED=42
